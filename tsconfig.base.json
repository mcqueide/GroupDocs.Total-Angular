{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "downlevelIteration": true,
    "module": "es2020",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@groupdocs.examples.angular/annotation": [
        "libs/annotation/src/index.ts"
      ],
      "@groupdocs.examples.angular/common-components": [
        "dist/libs/common-components",
        "libs/common-components/src/index.ts"
      ],
      "@groupdocs.examples.angular/viewer": ["libs/viewer/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
