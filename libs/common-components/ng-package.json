{
  "$schema": "../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/common-components",
  "lib": {
    "entryFile": "src/index.ts",
    "umdModuleIds": {
      "@fortawesome/angular-fontawesome": "angularFontawesome",
      "@fortawesome/free-solid-svg-icons": "freeSolidSvgIcons",
      "@fortawesome/free-regular-svg-icons": "freeRegularSvgIcons",
      "jquery": "jquery",
      "ng-click-outside": "ngClickOutside",
      "@ngx-translate/core": "ngxTranslateCore",
      "hammerjs": "Hammer"
    }
  },
  "allowedNonPeerDependencies": [
    "@groupdocs.examples.angular/common-components",
    "@fortawesome/angular-fontawesome",
    "@fortawesome/fontawesome-svg-core",
    "@fortawesome/free-regular-svg-icons",
    "@fortawesome/free-solid-svg-icons",
    "@ngx-translate/core",
    "ng-click-outside",
    "hammerjs",
    "jquery",
    "smoothscroll-polyfill"
  ]
}
