{
  "npmScope": "groupdocs.examples.angular",
  "implicitDependencies": {
    "angular.json": "*",
    "package.json": "*",
    "tsconfig.json": "*",
    "tslint.json": "*",
    "nx.json": "*"
  },
  "projects": {
    "annotation": {
      "tags": []
    },
    "common-components": {
      "tags": []
    },
    "total-angular": {
      "tags": []
    },
    "total-angular-e2e": {
      "tags": [],
      "implicitDependencies": ["total-angular"]
    },
    "viewer": {
      "tags": []
    }
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "@nrwl/workspace/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test", "e2e"]
      }
    }
  },
  "targetDependencies": {
    "build": [
      {
        "target": "build",
        "projects": "dependencies"
      }
    ]
  }
}
